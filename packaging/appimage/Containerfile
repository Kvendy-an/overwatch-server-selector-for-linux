FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
    python3 python3-gi python3-gi-cairo gir1.2-gtk-4.0 gir1.2-adw-1 \
    libgtk-4-1 libadwaita-1-0 librsvg2-common adwaita-icon-theme \
    ca-certificates fonts-dejavu-core binutils libglib2.0-bin \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
CMD ["python3", "packaging/appimage/build_appdir.py"]
